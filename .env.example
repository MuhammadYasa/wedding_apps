# Database Configuration
DB_DSN=mysql:host=localhost;dbname=wedding_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Application Configuration
APP_NAME="Wedding Invitation"
APP_ENV=dev
DEBUG_MODE=true
YII_DEBUG=true
YII_ENV=dev

# Cookie Validation Key (generate random string untuk production)
COOKIE_VALIDATION_KEY=

# Admin Default Credentials (ganti setelah first login!)
DEFAULT_ADMIN_USERNAME=nearhxh
DEFAULT_ADMIN_EMAIL=nearhxh@example.com
DEFAULT_ADMIN_PASSWORD=yasak123

# Email Configuration (optional - untuk RSVP confirmation)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
EMAIL_FROM=noreply@wedding.com
EMAIL_FROM_NAME="Wedding Invitation"

# Upload Configuration
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# Application URLs
BASE_URL=http://localhost:8080
